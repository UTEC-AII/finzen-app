# Copia este archivo como .env y completa los valores.

# Clave de OpenAI (opcional). Si no se define, el ai-service usa el modo local
# con un embedding determinista para poder probar sin conexión.
OPENAI_API_KEY=

# Secreto para firmar y verificar los tokens JWT (debe ser el mismo en todos los servicios).
SECRET_KEY=finzen-dev-secret-change-me

# Orígenes permitidos por CORS (el frontend Next.js en desarrollo).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
