{
  "info": {
    "name": "FinZen",
    "description": "Colección de APIs de FinZen (4 microservicios FastAPI detrás de Nginx).\n\nOrden sugerido: 1) Register, 2) Login (guarda el token automáticamente), 3) crea ingresos/gastos, 4) consultas al asistente IA.\n\nLa variable baseUrl se define en el entorno (Local = http://localhost, AWS = http://<IP-ELASTICA>).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "incomeId", "value": "" },
    { "key": "expenseId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera un correo único para este registro y lo guarda para el login.",
                  "pm.collectionVariables.set('email', 'demo' + Date.now() + '@test.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const registerData = pm.response.json();",
                  "if (registerData && registerData.id) { pm.collectionVariables.set('userId', registerData.id); }",
                  "pm.test('Creado (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/users", "host": ["{{baseUrl}}"], "path": ["api", "users", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo\",\n  \"email\": \"{{email}}\",\n  \"password\": \"secreto123\",\n  \"preferred_currency\": \"PEN\",\n  \"timezone\": \"America/Lima\"\n}"
            }
          }
        },
        {
          "name": "Login (guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loginData = pm.response.json();",
                  "if (loginData && loginData.access_token) { pm.collectionVariables.set('token', loginData.access_token); }",
                  "if (loginData && loginData.user) { pm.collectionVariables.set('userId', loginData.user.id); }",
                  "pm.test('OK (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "users", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"secreto123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Usuarios",
      "item": [
        {
          "name": "Obtener perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "users", "{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Actualizado\",\n  \"preferred_currency\": \"USD\",\n  \"timezone\": \"America/Lima\",\n  \"monthly_savings_goal\": \"100.00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Ingresos",
      "item": [
        {
          "name": "Registrar ingreso",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const incomeData = pm.response.json();",
                  "if (incomeData && incomeData.id) { pm.collectionVariables.set('incomeId', incomeData.id); }",
                  "pm.test('Creado (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/incomes/incomes", "host": ["{{baseUrl}}"], "path": ["api", "incomes", "incomes"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"type\": \"Sueldo\",\n  \"amount\": \"3500.50\",\n  \"currency\": \"PEN\",\n  \"date\": \"2026-09-01\",\n  \"description\": \"Sueldo de setiembre\"\n}"
            }
          }
        },
        {
          "name": "Listar ingresos",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/incomes/incomes/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "incomes", "incomes", "{{userId}}"] }
          }
        },
        {
          "name": "Detalle de ingreso",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/incomes/incomes/detail/{{incomeId}}", "host": ["{{baseUrl}}"], "path": ["api", "incomes", "incomes", "detail", "{{incomeId}}"] }
          }
        },
        {
          "name": "Eliminar ingreso",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/incomes/incomes/{{incomeId}}", "host": ["{{baseUrl}}"], "path": ["api", "incomes", "incomes", "{{incomeId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Gastos",
      "item": [
        {
          "name": "Registrar gasto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expenseData = pm.response.json();",
                  "if (expenseData && expenseData.id) { pm.collectionVariables.set('expenseId', expenseData.id); }",
                  "pm.test('Creado (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/expenses/expenses", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "expenses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"category\": \"Alimentacion\",\n  \"amount\": \"450.50\",\n  \"currency\": \"PEN\",\n  \"date\": \"2026-09-05\",\n  \"description\": \"Supermercado\"\n}"
            }
          }
        },
        {
          "name": "Registrar gasto (USD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/expenses/expenses", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "expenses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"category\": \"Entretenimiento\",\n  \"amount\": \"20.00\",\n  \"currency\": \"USD\",\n  \"date\": \"2026-09-06\",\n  \"description\": \"Netflix\"\n}"
            }
          }
        },
        {
          "name": "Listar gastos (filtro categoría)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/expenses/expenses/{{userId}}?category=Alimentacion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expenses", "expenses", "{{userId}}"],
              "query": [{ "key": "category", "value": "Alimentacion" }]
            }
          }
        },
        {
          "name": "Detalle de gasto",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/expenses/expenses/detail/{{expenseId}}", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "expenses", "detail", "{{expenseId}}"] }
          }
        },
        {
          "name": "Catálogo de categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/expenses/expenses/categories/list", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "expenses", "categories", "list"] }
          }
        },
        {
          "name": "Eliminar gasto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/expenses/expenses/{{expenseId}}", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "expenses", "{{expenseId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Asistente IA (HU7)",
      "item": [
        {
          "name": "Consulta 1: ¿en qué categoría gasto más?",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/ai/query", "host": ["{{baseUrl}}"], "path": ["api", "ai", "query"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"question\": \"¿En qué categoría gasto más?\",\n  \"timezone\": \"America/Lima\"\n}"
            }
          }
        },
        {
          "name": "Consulta 2: ¿cuánto he gastado este mes?",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/ai/query", "host": ["{{baseUrl}}"], "path": ["api", "ai", "query"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"question\": \"¿Cuánto he gastado este mes?\",\n  \"timezone\": \"America/Lima\"\n}"
            }
          }
        },
        {
          "name": "Consulta 3: ¿cuánto he recibido de ingresos?",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/ai/query", "host": ["{{baseUrl}}"], "path": ["api", "ai", "query"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"question\": \"¿Cuánto he recibido de ingresos?\",\n  \"timezone\": \"America/Lima\"\n}"
            }
          }
        },
        {
          "name": "Re-indexar movimientos",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/ai/reindex", "host": ["{{baseUrl}}"], "path": ["api", "ai", "reindex"] }
          }
        },
        {
          "name": "Estado de la clave de OpenAI",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/ai/settings/openai-key", "host": ["{{baseUrl}}"], "path": ["api", "ai", "settings", "openai-key"] }
          }
        }
      ]
    }
  ]
}
